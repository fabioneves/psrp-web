#!/bin/sh
# Player One helper installed inside the container as /usr/local/bin/psrp.
#   psrp update [--force]   pull the latest code and rebuild (refuses while a stream runs)
#   psrp status             container health, version and stream state
#   psrp logs [n]           last n log lines (default 100)
#   psrp save-log           archive the current log to ~/psrp-logs
#   psrp restart            restart the app without rebuilding
#   psrp backup             save the database and encryption keys to ~/psrp-backups/<timestamp>
#   psrp restore <dir>      replace every account, pairing and setting with a backup
#   psrp diagnostics        copy captures sent from browsers to ~/psrp-diagnostics and list them
set -eu
APP_DIR=${APP_DIR:-/opt/psrp}
cd "$APP_DIR"
port=$(grep -E '^PORT=' .env 2>/dev/null | cut -d= -f2)
port=${port:-8080}
health() { curl -fsS -m 5 "http://127.0.0.1:$port/healthz" 2>/dev/null || true; }
streams() { health | sed -n 's/.*"streams":\([0-9]*\).*/\1/p'; }
save_log() {
    mkdir -p ~/psrp-logs
    file=~/psrp-logs/$(date -u +%Y%m%dT%H%M%SZ).log
    docker compose logs --timestamps remote-play > "$file" 2>&1
    echo "Saved $file"
}
case "${1:-}" in
    update)
        if [ "${2:-}" != --force ] && [ "$(streams)" = 1 ]; then
            echo "A stream is running; updating would end it. Wait for it to finish or use: psrp update --force" >&2
            exit 1
        fi
        before=$(git rev-parse --short HEAD)
        git fetch -q origin
        branch=$(git rev-parse --abbrev-ref HEAD)
        if [ "$(git rev-parse HEAD)" = "$(git rev-parse "origin/$branch")" ]; then
            echo "Already up to date at $before."
            [ "${2:-}" = --force ] || exit 0
        fi
        save_log
        git merge -q --ff-only "origin/$branch"
        after=$(git rev-parse --short HEAD)
        install -m 0755 deploy/proxmox/psrp /usr/local/bin/psrp && install -m 0755 deploy/proxmox/psrp /usr/bin/psrp
        APP_VERSION=$after docker compose up --build -d
        until [ -n "$(health)" ]; do sleep 3; done
        docker image prune -f >/dev/null
        docker builder prune -f --keep-storage 3GB >/dev/null 2>&1 || true
        echo "Updated $before -> $after. $(health)"
        ;;
    status)
        echo "Version   $(git rev-parse --short HEAD) ($(git log -1 --format=%cd --date=short))"
        echo "Health    $(health)"
        echo "Disk      $(df -h / | awk 'NR==2 {print $3" used of "$2" ("$5")"}')  ·  docker: $(docker system df --format '{{.Type}} {{.Size}}' | tr '\n' ' ')"
        docker compose ps
        ;;
    logs) docker compose logs --tail "${2:-100}" remote-play ;;
    save-log) save_log ;;
    restart) docker compose restart remote-play && until [ -n "$(health)" ]; do sleep 3; done && health && echo ;;
    diagnostics)
        mkdir -p ~/psrp-diagnostics
        docker compose cp remote-play:/data/diagnostics/. ~/psrp-diagnostics/ 2>/dev/null || { echo "No captures have been sent to this server yet."; exit 0; }
        find ~/psrp-diagnostics -name '*.json' -printf '%TY-%Tm-%Td %TH:%TM  %6k KB  %p\n' | sort -r | head -40
        ;;
    backup)
        dir=~/psrp-backups/$(date -u +%Y%m%dT%H%M%SZ)
        mkdir -p "$dir"
        docker compose exec -T database sh -c 'pg_dump --clean --if-exists -U "$POSTGRES_USER" "$POSTGRES_DB"' | gzip > "$dir/database.sql.gz"
        docker compose cp remote-play:/data "$dir/app-data" >/dev/null
        echo "Saved $dir ($(du -sh "$dir" | cut -f1)): accounts, pairings, settings and the keys that decrypt saved PSN tokens. Copy it off this container."
        ;;
    restore)
        dir=${2:?usage: psrp restore ~/psrp-backups/<timestamp>}
        [ -f "$dir/database.sql.gz" ] && [ -d "$dir/app-data" ] || { echo "$dir is not a psrp backup." >&2; exit 1; }
        if [ "$(streams)" = 1 ]; then echo "A stream is running; restoring would end it." >&2; exit 1; fi
        printf 'This replaces every account, pairing and setting with %s. Continue? [y/N] ' "$dir"; read -r answer
        [ "$answer" = y ] || [ "$answer" = Y ] || exit 1
        docker compose stop remote-play
        gunzip -c "$dir/database.sql.gz" | docker compose exec -T database sh -c 'psql -q -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" "$POSTGRES_DB"' >/dev/null
        docker compose cp "$dir/app-data/." remote-play:/data/ >/dev/null
        docker compose run --rm --no-deps --user root --entrypoint chown remote-play -R app:app /data >/dev/null
        docker compose start remote-play
        until [ -n "$(health)" ]; do sleep 3; done
        echo "Restored $dir. $(health)"
        ;;
    *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
