PORT=8080
DB_PORT=15432
DB_PASSWORD=remoteplay-local
# Optional. Leave empty to generate a secret stored in the app-data volume.
JWT_SECRET=
# Registration is open only until the first account exists. Set true to keep it open.
ALLOW_REGISTRATION=false
DECODER_THREADS=1
ENCODER_THREADS=4
# Optional automatic discovery through Docker: your LAN subnet, not a console IP.
DISCOVERY_SUBNETS=
# Optional HTTPS overlay:
# REMOTE_PLAY_DOMAIN=play.example.com
# COMPOSE_FILE=compose.yaml:compose.https.yaml            # bridge networking
# COMPOSE_FILE=compose.yaml:compose.host.yaml:compose.https.yaml:compose.lxc.yaml   # host networking (LXC)
# Ports Caddy answers on: published ports in bridge mode, listen ports in host mode.
# HTTPS_PORT=443
# HTTP_PORT=80
# HTTP_BIND=127.0.0.1
